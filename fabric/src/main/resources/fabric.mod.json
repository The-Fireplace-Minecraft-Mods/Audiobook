{
  "schemaVersion": 1,
  "id": "audiobook",
  "version": "${version}",
  "name": "${readable_name}",
  "description": "${mod_description}",
  "authors": [
    "The_Fireplace"
  ],
  "contact": {
    "homepage": "${curseforge_url}",
    "sources": "${github_url}",
    "issues": "${github_url}/issues",
    "modrinth": "${modrinth_url}"
  },
  "license": "${license_id}",
  "icon": "${logo_filename}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.the_fireplace.audiobook.entrypoints.Client"
    ]
  },
  "mixins": [
    "audiobook.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.12.0",
    "fabric": "*",
    "minecraft": ">=1.20.5"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}",
        "annotateddi.twitter": "${twitter_url}",
        "annotateddi.kofi": "${kofi_url}"
      }
    }
  }
}